# ==============================================================================
# PSX Portfolio Tracker - Environment Configuration Template
# ==============================================================================

# Application Environment (development, testing, production)
FLASK_ENV=development
APP_SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=INFO

# PostgreSQL Configuration
DATABASE_URL=postgresql://psx_user:psx_password@localhost:5432/psx_portfolio
POSTGRES_USER=psx_user
POSTGRES_PASSWORD=psx_password
POSTGRES_DB=psx_portfolio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Security & Session Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Market Data Settings
MARKET_DATA_PROVIDER=mock
PSX_SCRAPER_RATE_LIMIT=10